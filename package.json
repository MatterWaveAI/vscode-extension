{
  "name": "matterwave",
  "displayName": "MatterWave",
  "description": "Chat with your organisation's MatterWave models from the editor.",
  "version": "0.3.0",
  "publisher": "matterwave",
  "private": false,
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0B0C0E",
    "theme": "dark"
  },
  "keywords": [
    "matterwave",
    "ai",
    "chat",
    "llm",
    "assistant",
    "code review",
    "inline edit"
  ],
  "homepage": "https://github.com/MatterWaveAI/vscode-extension#readme",
  "bugs": {
    "url": "https://github.com/MatterWaveAI/vscode-extension/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MatterWaveAI/vscode-extension"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode MatterWave chats and reads context, but does not change files (Apply, inline edit, Restore Checkpoint) or run git for @git until the workspace is trusted."
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "configuration": {
      "title": "MatterWave",
      "properties": {
        "matterwave.baseUrl": {
          "type": "string",
          "default": "https://app.matterwave.dev",
          "description": "The MatterWave deployment this editor talks to.",
          "scope": "application"
        },
        "matterwave.caFile": {
          "type": "string",
          "default": "",
          "description": "Path to a PEM file holding the certificate authority that signed the deployment's TLS certificate, for a deployment behind a private CA. Trusted in addition to the system's authorities. Empty uses the system's authorities alone.",
          "scope": "application"
        },
        "matterwave.commitMessageStyle": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "markdownDescription": "How **Generate Commit Message** writes a message: a convention (Conventional Commits, a ticket prefix) or plain words. Empty uses a summary line of at most 72 characters in the imperative mood, a blank line, and a short body saying what changed and why. A workspace can set its own.",
          "scope": "resource"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "matterwave",
          "title": "MatterWave",
          "icon": "media/matterwave.svg"
        }
      ]
    },
    "views": {
      "matterwave": [
        {
          "type": "webview",
          "id": "matterwave.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "matterwave.signInWithDeviceCode",
        "title": "Sign In (Device Code)",
        "category": "MatterWave"
      },
      {
        "command": "matterwave.signInWithApiKey",
        "title": "Sign In with API Key",
        "category": "MatterWave"
      },
      {
        "command": "matterwave.signOut",
        "title": "Sign Out",
        "category": "MatterWave"
      },
      {
        "command": "matterwave.openChat",
        "title": "Open Chat",
        "category": "MatterWave"
      },
      {
        "command": "matterwave.newChat",
        "title": "New Chat",
        "category": "MatterWave",
        "icon": "$(add)"
      },
      {
        "command": "matterwave.askAboutSelection",
        "title": "Ask about Selection",
        "category": "MatterWave"
      },
      {
        "command": "matterwave.askAboutFile",
        "title": "Ask about File",
        "category": "MatterWave"
      },
      {
        "command": "matterwave.inlineEdit",
        "title": "Edit Selection with MatterWave",
        "category": "MatterWave"
      },
      {
        "command": "matterwave.fixProblem",
        "title": "Fix Problem",
        "category": "MatterWave"
      },
      {
        "command": "matterwave.explainCode",
        "title": "Explain Code",
        "category": "MatterWave"
      },
      {
        "command": "matterwave.generateTests",
        "title": "Generate Tests",
        "category": "MatterWave"
      },
      {
        "command": "matterwave.addDocs",
        "title": "Add Docs",
        "category": "MatterWave"
      },
      {
        "command": "matterwave.explainTerminalCommand",
        "title": "Explain Last Terminal Command",
        "category": "MatterWave"
      },
      {
        "command": "matterwave.fixTerminalCommand",
        "title": "Fix Last Terminal Command",
        "category": "MatterWave"
      },
      {
        "command": "matterwave.generateCommitMessage",
        "title": "Generate Commit Message",
        "category": "MatterWave",
        "icon": "$(sparkle)"
      },
      {
        "command": "matterwave.pickModel",
        "title": "Pick Model",
        "category": "MatterWave"
      },
      {
        "command": "matterwave.compactNow",
        "title": "Compact Conversation Now",
        "category": "MatterWave"
      },
      {
        "command": "matterwave.copyRequestId",
        "title": "Copy Last Request ID",
        "category": "MatterWave"
      },
      {
        "command": "matterwave.exportConversation",
        "title": "Export Conversation as Markdown",
        "category": "MatterWave"
      },
      {
        "command": "matterwave.shareConversation",
        "title": "Create Share Link",
        "category": "MatterWave"
      },
      {
        "command": "matterwave.manageShares",
        "title": "Manage Share Links",
        "category": "MatterWave"
      },
      {
        "command": "matterwave.organizeConversation",
        "title": "Organize",
        "category": "MatterWave"
      },
      {
        "command": "matterwave.manageTags",
        "title": "Manage Tags",
        "category": "MatterWave"
      },
      {
        "command": "matterwave.customInstructions",
        "title": "Edit Custom Instructions",
        "category": "MatterWave"
      },
      {
        "command": "matterwave.manageApiKeys",
        "title": "Manage API Keys",
        "category": "MatterWave"
      },
      {
        "command": "matterwave.switchAccount",
        "title": "Switch Account",
        "category": "MatterWave"
      },
      {
        "command": "matterwave.promptLibrary",
        "title": "Prompt Library",
        "category": "MatterWave"
      },
      {
        "command": "matterwave.restoreCheckpoint",
        "title": "Restore Checkpoint",
        "category": "MatterWave"
      },
      {
        "command": "matterwave.importHistory",
        "title": "Import ChatGPT or Claude History",
        "category": "MatterWave"
      },
      {
        "command": "matterwave.showLog",
        "title": "Show Log",
        "category": "MatterWave"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "matterwave.newChat",
          "when": "view == matterwave.chat",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "matterwave.askAboutSelection",
          "when": "editorHasSelection",
          "group": "matterwave@1"
        },
        {
          "command": "matterwave.askAboutFile",
          "when": "editorTextFocus",
          "group": "matterwave@2"
        },
        {
          "command": "matterwave.inlineEdit",
          "when": "editorHasSelection && isWorkspaceTrusted",
          "group": "matterwave@3"
        }
      ],
      "terminal/context": [
        {
          "command": "matterwave.explainTerminalCommand",
          "group": "matterwave@1"
        },
        {
          "command": "matterwave.fixTerminalCommand",
          "group": "matterwave@2"
        }
      ],
      "scm/title": [
        {
          "command": "matterwave.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "matterwave.inlineEdit",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && editorHasSelection && isWorkspaceTrusted && !inlineChatHasProvider && !inlineChatHasEditsAgent"
      },
      {
        "command": "matterwave.inlineEdit",
        "key": "ctrl+alt+m i",
        "mac": "ctrl+cmd+m i",
        "when": "editorTextFocus && editorHasSelection && isWorkspaceTrusted"
      },
      {
        "command": "matterwave.openChat",
        "key": "ctrl+alt+m c",
        "mac": "ctrl+cmd+m c"
      },
      {
        "command": "matterwave.newChat",
        "key": "ctrl+alt+m n",
        "mac": "ctrl+cmd+m n"
      },
      {
        "command": "matterwave.askAboutSelection",
        "key": "ctrl+alt+m a",
        "mac": "ctrl+cmd+m a",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "walkthroughs": [
      {
        "id": "matterwave.gettingStarted",
        "title": "Get started with MatterWave",
        "description": "Sign in, ask about your code, and let MatterWave change it under review.",
        "steps": [
          {
            "id": "signIn",
            "title": "Sign in",
            "description": "Confirm a code in your browser, or paste an API key. The credential stays in the editor's secret storage.\n[Sign In](command:matterwave.signInWithDeviceCode)",
            "media": {
              "markdown": "media/walkthrough/sign-in.md"
            },
            "completionEvents": [
              "onCommand:matterwave.signInWithDeviceCode",
              "onCommand:matterwave.signInWithApiKey"
            ]
          },
          {
            "id": "askAboutSelection",
            "title": "Ask about a selection",
            "description": "Select some code and ask about it; the answer streams into the chat view.\n[Ask about Selection](command:matterwave.askAboutSelection)",
            "media": {
              "markdown": "media/walkthrough/ask.md"
            },
            "completionEvents": [
              "onCommand:matterwave.askAboutSelection"
            ]
          },
          {
            "id": "apply",
            "title": "Apply an answer's code",
            "description": "Every code block in an answer has Apply. A diff opens first, and the change lands in the editor, where Undo takes it back.\n[Open Chat](command:matterwave.openChat)",
            "media": {
              "markdown": "media/walkthrough/apply.md"
            },
            "completionEvents": [
              "onCommand:matterwave.openChat"
            ]
          },
          {
            "id": "inlineEdit",
            "title": "Edit in place",
            "description": "Select lines, say what should change, and review the diff before it lands.\n[Edit Selection](command:matterwave.inlineEdit)",
            "media": {
              "markdown": "media/walkthrough/inline-edit.md"
            },
            "completionEvents": [
              "onCommand:matterwave.inlineEdit"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm run build && node e2e/run.mjs",
    "package": "pnpm run build && vsce package --no-dependencies",
    "icon": "node scripts/icon.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/mocha": "10.0.10",
    "@types/node": "^22.10.0",
    "@types/vscode": "~1.93.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "happy-dom": "^15.11.7",
    "mocha": "12.0.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.12.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

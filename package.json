{
  "name": "matterwave",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.3.0",
  "publisher": "matterwave",
  "private": false,
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0B0C0E",
    "theme": "dark"
  },
  "keywords": [
    "matterwave",
    "ai",
    "chat",
    "llm",
    "assistant",
    "code review",
    "inline edit"
  ],
  "homepage": "https://github.com/MatterWaveAI/vscode-extension#readme",
  "bugs": {
    "url": "https://github.com/MatterWaveAI/vscode-extension/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MatterWaveAI/vscode-extension"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces.description%",
      "restrictedConfigurations": [
        "matterwave.agent.mcpServers"
      ]
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "matterwave.baseUrl": {
          "type": "string",
          "default": "https://app.matterwave.ai",
          "description": "%config.baseUrl.description%",
          "scope": "application"
        },
        "matterwave.caFile": {
          "type": "string",
          "default": "",
          "description": "%config.caFile.description%",
          "scope": "application"
        },
        "matterwave.commitMessageStyle": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "markdownDescription": "%config.commitMessageStyle.markdownDescription%",
          "scope": "resource"
        },
        "matterwave.showAnswerUsage": {
          "type": "boolean",
          "default": true,
          "description": "%config.showAnswerUsage.description%"
        },
        "matterwave.agent.defaultMode": {
          "type": "string",
          "enum": [
            "plan",
            "ask",
            "auto-edit"
          ],
          "enumDescriptions": [
            "%config.agent.defaultMode.plan%",
            "%config.agent.defaultMode.ask%",
            "%config.agent.defaultMode.autoEdit%"
          ],
          "default": "ask",
          "description": "%config.agent.defaultMode.description%",
          "scope": "window"
        },
        "matterwave.agent.engine": {
          "type": "string",
          "enum": [
            "auto",
            "pi",
            "builtin"
          ],
          "default": "auto",
          "description": "%config.agent.engine.description%",
          "scope": "window"
        },
        "matterwave.agent.piBinaryPath": {
          "type": "string",
          "default": "pi",
          "description": "%config.agent.piBinaryPath.description%",
          "scope": "window"
        },
        "matterwave.agent.maxSteps": {
          "type": "integer",
          "default": 40,
          "minimum": 1,
          "maximum": 500,
          "description": "%config.agent.maxSteps.description%",
          "scope": "window"
        },
        "matterwave.agent.maxTokens": {
          "type": "integer",
          "default": 500000,
          "minimum": 1000,
          "description": "%config.agent.maxTokens.description%",
          "scope": "window"
        },
        "matterwave.agent.editorContext": {
          "type": "boolean",
          "default": true,
          "description": "%config.agent.editorContext.description%",
          "scope": "window"
        },
        "matterwave.agent.webFetch": {
          "type": "boolean",
          "default": true,
          "description": "%config.agent.webFetch.description%",
          "scope": "window"
        },
        "matterwave.agent.matterwaveMcp": {
          "type": "boolean",
          "default": true,
          "description": "%config.agent.matterwaveMcp.description%",
          "scope": "window"
        },
        "matterwave.agent.mcpServers": {
          "type": "object",
          "default": {},
          "markdownDescription": "%config.agent.mcpServers.markdownDescription%",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "trust": {
                "type": "boolean"
              },
              "disabled": {
                "type": "boolean"
              }
            }
          },
          "scope": "window"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "matterwave",
          "title": "%viewsContainer.matterwave.title%",
          "icon": "media/matterwave.svg"
        }
      ]
    },
    "views": {
      "matterwave": [
        {
          "type": "webview",
          "id": "matterwave.chat",
          "name": "%view.chat.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "matterwave.signInWithDeviceCode",
        "title": "%command.signInWithDeviceCode.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.signInWithApiKey",
        "title": "%command.signInWithApiKey.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.signOut",
        "title": "%command.signOut.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.openChat",
        "title": "%command.openChat.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.newChat",
        "title": "%command.newChat.title%",
        "category": "%command.category%",
        "icon": "$(add)"
      },
      {
        "command": "matterwave.askAboutSelection",
        "title": "%command.askAboutSelection.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.askAboutFile",
        "title": "%command.askAboutFile.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.inlineEdit",
        "title": "%command.inlineEdit.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.fixProblem",
        "title": "%command.fixProblem.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.explainCode",
        "title": "%command.explainCode.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.generateTests",
        "title": "%command.generateTests.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.addDocs",
        "title": "%command.addDocs.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.explainTerminalCommand",
        "title": "%command.explainTerminalCommand.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.fixTerminalCommand",
        "title": "%command.fixTerminalCommand.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.generateCommitMessage",
        "title": "%command.generateCommitMessage.title%",
        "category": "%command.category%",
        "icon": "$(sparkle)"
      },
      {
        "command": "matterwave.pickModel",
        "title": "%command.pickModel.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.choosePreset",
        "title": "%command.choosePreset.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.compactNow",
        "title": "%command.compactNow.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.copyRequestId",
        "title": "%command.copyRequestId.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.exportConversation",
        "title": "%command.exportConversation.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.shareConversation",
        "title": "%command.shareConversation.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.manageShares",
        "title": "%command.manageShares.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.organizeConversation",
        "title": "%command.organizeConversation.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.manageTags",
        "title": "%command.manageTags.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.manageFolders",
        "title": "%command.manageFolders.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.reportConversation",
        "title": "%command.reportConversation.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.customInstructions",
        "title": "%command.customInstructions.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.account",
        "title": "%command.account.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.manageApiKeys",
        "title": "%command.manageApiKeys.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.switchAccount",
        "title": "%command.switchAccount.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.promptLibrary",
        "title": "%command.promptLibrary.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.restoreCheckpoint",
        "title": "%command.restoreCheckpoint.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.importHistory",
        "title": "%command.importHistory.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.showLog",
        "title": "%command.showLog.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.agent.toggle",
        "title": "%command.agent.toggle.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.agent.setMode",
        "title": "%command.agent.setMode.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.agent.cycleMode",
        "title": "%command.agent.cycleMode.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.agent.accept",
        "title": "%command.agent.accept.title%",
        "category": "%command.category%",
        "icon": "$(check)"
      },
      {
        "command": "matterwave.agent.reject",
        "title": "%command.agent.reject.title%",
        "category": "%command.category%",
        "icon": "$(close)"
      },
      {
        "command": "matterwave.agent.pickRoot",
        "title": "%command.agent.pickRoot.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.agent.init",
        "title": "%command.agent.init.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.agent.resume",
        "title": "%command.agent.resume.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.showUsage",
        "title": "%command.showUsage.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.dictatePrompt",
        "title": "%command.dictatePrompt.title%",
        "category": "%command.category%"
      },
      {
        "command": "matterwave.selectAgentEngine",
        "title": "%command.selectAgentEngine.title%",
        "category": "%command.category%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "matterwave.newChat",
          "when": "view == matterwave.chat",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "matterwave.askAboutSelection",
          "when": "editorHasSelection",
          "group": "matterwave@1"
        },
        {
          "command": "matterwave.askAboutFile",
          "when": "editorTextFocus",
          "group": "matterwave@2"
        },
        {
          "command": "matterwave.inlineEdit",
          "when": "editorHasSelection && isWorkspaceTrusted",
          "group": "matterwave@3"
        }
      ],
      "terminal/context": [
        {
          "command": "matterwave.explainTerminalCommand",
          "group": "matterwave@1"
        },
        {
          "command": "matterwave.fixTerminalCommand",
          "group": "matterwave@2"
        }
      ],
      "scm/title": [
        {
          "command": "matterwave.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "matterwave.agent.reject",
          "when": "matterwave.agentReviewing && isInDiffEditor",
          "group": "navigation@1"
        },
        {
          "command": "matterwave.agent.accept",
          "when": "matterwave.agentReviewing && isInDiffEditor",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "matterwave.agent.accept",
          "when": "matterwave.agentReviewing"
        },
        {
          "command": "matterwave.agent.reject",
          "when": "matterwave.agentReviewing"
        }
      ]
    },
    "keybindings": [
      {
        "command": "matterwave.inlineEdit",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && editorHasSelection && isWorkspaceTrusted && !inlineChatHasProvider && !inlineChatHasEditsAgent"
      },
      {
        "command": "matterwave.inlineEdit",
        "key": "ctrl+alt+m i",
        "mac": "ctrl+cmd+m i",
        "when": "editorTextFocus && editorHasSelection && isWorkspaceTrusted"
      },
      {
        "command": "matterwave.openChat",
        "key": "ctrl+alt+m c",
        "mac": "ctrl+cmd+m c"
      },
      {
        "command": "matterwave.newChat",
        "key": "ctrl+alt+m n",
        "mac": "ctrl+cmd+m n"
      },
      {
        "command": "matterwave.askAboutSelection",
        "key": "ctrl+alt+m a",
        "mac": "ctrl+cmd+m a",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "walkthroughs": [
      {
        "id": "matterwave.gettingStarted",
        "title": "%walkthrough.gettingStarted.title%",
        "description": "%walkthrough.gettingStarted.description%",
        "steps": [
          {
            "id": "signIn",
            "title": "%walkthrough.gettingStarted.signIn.title%",
            "description": "%walkthrough.gettingStarted.signIn.description%",
            "media": {
              "markdown": "media/walkthrough/sign-in.md"
            },
            "completionEvents": [
              "onCommand:matterwave.signInWithDeviceCode",
              "onCommand:matterwave.signInWithApiKey"
            ]
          },
          {
            "id": "askAboutSelection",
            "title": "%walkthrough.gettingStarted.askAboutSelection.title%",
            "description": "%walkthrough.gettingStarted.askAboutSelection.description%",
            "media": {
              "markdown": "media/walkthrough/ask.md"
            },
            "completionEvents": [
              "onCommand:matterwave.askAboutSelection"
            ]
          },
          {
            "id": "apply",
            "title": "%walkthrough.gettingStarted.apply.title%",
            "description": "%walkthrough.gettingStarted.apply.description%",
            "media": {
              "markdown": "media/walkthrough/apply.md"
            },
            "completionEvents": [
              "onCommand:matterwave.openChat"
            ]
          },
          {
            "id": "inlineEdit",
            "title": "%walkthrough.gettingStarted.inlineEdit.title%",
            "description": "%walkthrough.gettingStarted.inlineEdit.description%",
            "media": {
              "markdown": "media/walkthrough/inline-edit.md"
            },
            "completionEvents": [
              "onCommand:matterwave.inlineEdit"
            ]
          }
        ]
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "matterwave.mcp",
        "label": "MatterWave"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm run build && node e2e/run.mjs",
    "package": "pnpm run build && vsce package --no-dependencies",
    "icon": "node scripts/icon.mjs",
    "sdk:check": "node scripts/sdk-agent.mjs --check",
    "sdk:sync": "node scripts/sdk-agent.mjs --sync"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/mocha": "10.0.10",
    "@types/node": "^22.10.0",
    "@types/vscode": "~1.93.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^3.2.1",
    "axe-core": "^4.14.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "happy-dom": "^15.11.7",
    "mocha": "12.0.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.12.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
